    {
      "parameters": {
        "jsCode": "let url = \"https://www.linkedin.com/jobs/search/?f_TPR=r86400\";\n\nconst keyword = $input.first().json.Keyword;\nconst location = $input.first().json.Location;\nconst experienceLevel = $input.first().json['Experience Level'];\nconst remote = $input.first().json.Remote;\nconst jobType = $input.first().json['Job Type'];\nconst easyApply = $input.first().json['Easy Apply'];\n\nif (keyword) {\n  url += `&keywords=${encodeURIComponent(keyword)}`;\n}\n\nif (location) {\n  url += `&location=${encodeURIComponent(location)}`;\n}\n\n// Experience Level\nif (experienceLevel) {\n  const transformedExperiences = experienceLevel\n    .split(\",\")\n    .map((exp) => {\n      switch (exp.trim()) {\n        case \"Internship\": return \"1\";\n        case \"Entry level\": return \"2\";\n        case \"Fresher\": return \"2\"; // FIXED\n        case \"Associate\": return \"3\";\n        case \"Mid-Senior level\": return \"4\";\n        case \"mid level\": return \"4\"; // optional\n        case \"Director\": return \"5\";\n        case \"Executive\": return \"6\";\n        default: return \"\";\n      }\n    })\n    .filter(Boolean);\n\n  if (transformedExperiences.length) {\n    url += `&f_E=${transformedExperiences.join(\",\")}`;\n  }\n}\n\n// Remote\nif (remote) {\n  const transformedRemote = remote\n    .split(\",\")\n    .map((e) => {\n      switch (e.trim()) {\n        case \"Remote\": return \"2\";\n        case \"Hybrid\": return \"3\";\n        case \"On-site\":\n        case \"On-Site\": return \"1\";\n        default: return \"\";\n      }\n    })\n    .filter(Boolean);\n\n  if (transformedRemote.length) {\n    url += `&f_WT=${transformedRemote.join(\",\")}`;\n  }\n}\n\n// Job Type\nif (jobType) {\n  const transformedJobType = jobType\n    .split(\",\")\n    .map((type) => {\n      switch (type.trim()) {\n        case \"Full-time\": return \"F\";\n        case \"Part-time\": return \"P\";\n        case \"Contract\": return \"C\";\n        case \"Internship\": return \"I\";\n        default: return \"\";\n      }\n    })\n    .filter(Boolean);\n\n  if (transformedJobType.length) {\n    url += `&f_JT=${transformedJobType.join(\",\")}`;\n  }\n}\n\n// Easy Apply\nif (easyApply && easyApply.toString().toLowerCase() === \"true\") {\n  url += \"&f_EA=true\";\n}\n\nreturn { url };"
      },
